!python/data/shenzhen.json
!experiments/data/test_queries.py
!experiments/data/dataset_loader.py

# Debug files
debug-*.png
debug-*.html
evidencdebug/

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Output directories
output/
results/
data/  # Generated data (keep sample data above)

# Streamlit
.streamlit/secrets.toml

# LaTeX build files
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
